            "option": "\n<#ff7a3eff>富の共有<>: <#e8a800ff>5秒<>ごとに<#e2ba3dff>4の<i#asset/base/ui/banpick/champion_stat_icon:gold_0> ゴールド<>を得る。\n\n<#ff7a3eff>山の祝福<>: 敵チャンピオンからダメージを受けると<#92dc7bff>祝福<>状態になり、<#e8a800ff>2秒間<>受けるダメージが<#e8a800ff>15%<>減少する。<#92dc7bff>祝福<>が終了すると、自身の周囲に衝撃波を放ち、周囲の敵を<#e8a800ff>1.5秒間<><#d94c49ff>50%<><#d94c49ff>鈍化させる<>(クールダウン<#e8a800ff>18秒<>、爆発後に開始)。"
        },
        "radiant_celestial_opposition": {
            "name": "レディアント セレスティアル オポジション",
            "option": "\n<#ff7a3eff>富の共有<>: <#e8a800ff>5秒<>ごとに<#e2ba3dff>4の<i#asset/base/ui/banpick/champion_stat_icon:gold_0> ゴールド<>を得る。\n\n<#ff7a3eff>山の祝福<>: 敵チャンピオンからダメージを受けると<#92dc7bff>祝福<>状態になり、<#e8a800ff>2秒間<>受けるダメージが<#e8a800ff>15%<>減少する。<#92dc7bff>祝福<>が終了すると、自身の周囲に衝撃波を放ち、周囲の敵を<#e8a800ff>1.5秒間<><#d94c49ff>50%<><#d94c49ff>鈍化させる<>(クールダウン<#e8a800ff>18秒<>、爆発後に開始)。"
        },
        "dream_maker": {
            "name": "ドリーム メーカー",
            "option": "\n<#ff7a3eff>富の共有<>: <#e8a800ff>5秒<>ごとに<#e2ba3dff>4の<i#asset/base/ui/banpick/champion_stat_icon:gold_0> ゴールド<>を得る。\n\n<#ff7a3eff>ドリーム メーカー<>: 味方チャンピオンを回復、シールド付与、または強化すると、<#e8a800ff>5秒間<>対象に<#64b6f6ff>夢の泡<>を付与する。<#64b6f6ff>夢の泡<>が有効な間、<#92dc7bff>8%<>の<i#asset/base/ui/banpick/champion_stat_icon:skill_damage_reduction_0> <#92dc7bff>スキルダメージ減少<>と<#d48294ff>20<>の<i#asset/base/ui/banpick/champion_stat_icon:force_0> <#d48294ff>アダプティブフォース<>を得る(クールダウン<#e8a800ff>8秒<>、<#64b6f6ff>夢の泡<>の終了後に開始)。"
        },
        "radiant_dream_maker": {
            "name": "レディアント ドリーム メーカー",
            "option": "\n<#ff7a3eff>富の共有<>: <#e8a800ff>5秒<>ごとに<#e2ba3dff>4の<i#asset/base/ui/banpick/champion_stat_icon:gold_0> ゴールド<>を得る。\n\n<#ff7a3eff>ドリーム メーカー<>: 味方チャンピオンを回復、シールド付与、または強化すると、<#e8a800ff>5秒間<>対象に<#64b6f6ff>夢の泡<>を付与する。<#64b6f6ff>夢の泡<>が有効な間、<#92dc7bff>8%<>の<i#asset/base/ui/banpick/champion_stat_icon:skill_damage_reduction_0> <#92dc7bff>スキルダメージ減少<>と<#d48294ff>20<>の<i#asset/base/ui/banpick/champion_stat_icon:force_0> <#d48294ff>アダプティブフォース<>を得る(クールダウン<#e8a800ff>8秒<>、<#64b6f6ff>夢の泡<>の終了後に開始)。"
        },
        "catalyst_of_aeons": {
            "name": "久遠のカタリスト",
            "option": "\n<#ff7a3eff>久遠<>: スキルを使用するたびに<#60e84dff>15<> - <#60e84dff>40<>(<i#asset/base/ui/banpick/champion_stat_icon:level_0> <#d8c9b3ff>レベル<>に応じる)の<#60e84dff>体力<>を<i#asset/base/ui/banpick/champion_stat_icon:hp_regen_0> <#60e84dff>回復する<>。"
        },
        "rod_of_ages": {
            "name": "ロッド オブ エイジス",
            "option": "\n<#ff7a3eff>時空の超越者<>: このアイテムは<#e8a800ff>30秒<>ごとに<#60e84dff>10の<i#asset/base/ui/banpick/champion_stat_icon:hp_0> 体力<>、<#a974ffff>2の<i#asset/base/ui/banpick/champion_stat_icon:ap_0> 魔法力<>、<#61d1bcff>1の<i#asset/base/ui/banpick/champion_stat_icon:cdr_0> スキルヘイスト<>を得る(最大10回)。\n\n<#ff7a3eff>久遠<>: スキルを使用するたびに<#60e84dff>15<> - <#60e84dff>40<>(<i#asset/base/ui/banpick/champion_stat_icon:level_0> <#d8c9b3ff>レベル<>に応じる)の<#60e84dff>体力<>を<i#asset/base/ui/banpick/champion_stat_icon:hp_regen_0> <#60e84dff>回復する<>。"
        },
        "radiant_rod_of_ages": {
            "name": "レディアント ロッド オブ エイジス",
            "option": "\n<#ff7a3eff>時空の超越者<>: このアイテムは<#e8a800ff>30秒<>ごとに<#60e84dff>10の<i#asset/base/ui/banpick/champion_stat_icon:hp_0> 体力<>、<#a974ffff>2の<i#asset/base/ui/banpick/champion_stat_icon:ap_0> 魔法力<>、<#61d1bcff>1の<i#asset/base/ui/banpick/champion_stat_icon:cdr_0> スキルヘイスト<>を得る(最大10回)。\n\n<#ff7a3eff>久遠<>: スキルを使用するたびに<#60e84dff>15<> - <#60e84dff>40<>(<i#asset/base/ui/banpick/champion_stat_icon:level_0> <#d8c9b3ff>レベル<>に応じる)の<#60e84dff>体力<>を<i#asset/base/ui/banpick/champion_stat_icon:hp_regen_0> <#60e84dff>回復する<>。"
        },
        "mikaels_blessing": {
            "name": "ミカエルの祝福",
            "option": "\n<#92dc7bff>12%の<i#asset/base/ui/banpick/champion_stat_icon:heal_shield_power_0> 体力回復量とシールド量<>を得る。\n\n<#ff7a3eff>浄化<>: <#d94c49ff>体力が50%未満<>の味方チャンピオンが<#d94c49ff>行動妨害効果<>を受けると、その味方と自身からすべての行動妨害効果を解除し、対象の<#60e84dff>体力<>を<#60e84dff>100<> - <#60e84dff>265<>(対象の<i#asset/base/ui/banpick/champion_stat_icon:level_0> <#d8c9b3ff>レベル<>に応じる)<i#asset/base/ui/banpick/champion_stat_icon:hp_regen_0> <#60e84dff>回復する<>(クールダウン<#e8a800ff>120秒<>、<#ff86c2ff>65の<i#asset/base/ui/banpick/champion_stat_icon:range_0> 射程<>内の味方)。"
        },
        "radiant_mikaels_blessing": {
            "name": "レディアント ミカエルの祝福",
            "option": "\n<#92dc7bff>12%の<i#asset/base/ui/banpick/champion_stat_icon:heal_shield_power_0> 体力回復量とシールド量<>を得る。\n\n<#ff7a3eff>浄化<>: <#d94c49ff>体力が50%未満<>の味方チャンピオンが<#d94c49ff>行動妨害効果<>を受けると、その味方と自身からすべての行動妨害効果を解除し、対象の<#60e84dff>体力<>を<#60e84dff>100<> - <#60e84dff>265<>(対象の<i#asset/base/ui/banpick/champion_stat_icon:level_0> <#d8c9b3ff>レベル<>に応じる)<i#asset/base/ui/banpick/champion_stat_icon:hp_regen_0> <#60e84dff>回復する<>(クールダウン<#e8a800ff>120秒<>、<#ff86c2ff>65の<i#asset/base/ui/banpick/champion_stat_icon:range_0> 射程<>内の味方)。"
        },
        "force_of_nature": {
            "name": "自然の力",
            "option": "\n<#ff7a3eff>毅然<>: チャンピオンから<#a974ffff>魔法ダメージ<>を受けると、<#e8a800ff>7秒間<><#92dc7bff>毅然<>スタックを1つ得る(毎秒最大1スタック、最大8スタック)。敵チャンピオンから<#d94c49ff>移動不能効果<>を受けると2スタックを得る。スタックが最大のとき、<#88ccffff>70<>の増加<i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0> <#88ccffff>魔法抵抗力<>と<#ffffffff>6%<>の増加<i#asset/base/ui/banpick/champion_stat_icon:speed_0> <#ffffffff>移動速度<>を得る。"
        },
        "radiant_force_of_nature": {
            "name": "レディアント 自然の力",
            "option": "\n<#ff7a3eff>毅然<>: チャンピオンから<#a974ffff>魔法ダメージ<>を受けると、<#e8a800ff>7秒間<><#92dc7bff>毅然<>スタックを1つ得る(毎秒最大1スタック、最大8スタック)。敵チャンピオンから<#d94c49ff>移動不能効果<>を受けると2スタックを得る。スタックが最大のとき、<#88ccffff>70<>の増加<i#asset/base/ui/banpick/champion_stat_icon:magic resistance_0> <#88ccffff>魔法抵抗力<>と<#ffffffff>6%<>の増加<i#asset/base/ui/banpick/champion_stat_icon:speed_0> <#ffffffff>移動速度<>を得る。"
        },
        "navori_flickerblade": {
            "name": "ナヴォリ フリッカーブレード",
            "option": "\n<#ff7a3eff>至上<>: 通常攻撃が<#ffff99ff>攻撃時効果<>として、アルティメット以外のスキルの<i#asset/base/ui/banpick/champion_stat_icon:cdr_0> <#61d1bcff>残りクールダウン<>を<#61d1bcff>15%<>短縮する。"
