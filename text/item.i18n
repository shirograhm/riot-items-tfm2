        "statikk_shiv": {
            "name": "Statikk Shiv",
            "option": "\n<#ff7a3eff>Energized<>: Bewegen en basisaanvallen bouwen <#92dc7bff>Energize<>-stapels op, tot <#e8a800ff>100<>.\n\n<#ff7a3eff>Electrospark<>: Wanneer je volledig <#92dc7bff>Energized<> bent, vuurt je volgende basisaanval kettingbliksem af die <#ffff99ff>bij treffer<> <#a974ffff>60 magische schade<> toebrengt aan het doelwit en aan maximaal <#e8a800ff>4<> andere vijanden, elk binnen <#ff86c2ff>50 <i#asset/base/ui/banpick/champion_stat_icon:range_0> bereik<> van de vorige, met voorrang voor kampioenen. Dit effect werkt voor <#e8a800ff>150%<> tegen minions en monsters."
        },
        "radiant_statikk_shiv": {
            "name": "Radiant Statikk Shiv",
            "option": "\n<#ff7a3eff>Energized<>: Bewegen en basisaanvallen bouwen <#92dc7bff>Energize<>-stapels op, tot <#e8a800ff>100<>.\n\n<#ff7a3eff>Electrospark<>: Wanneer je volledig <#92dc7bff>Energized<> bent, vuurt je volgende basisaanval kettingbliksem af die <#ffff99ff>bij treffer<> <#a974ffff>80 magische schade<> toebrengt aan het doelwit en aan maximaal <#e8a800ff>5<> andere vijanden, elk binnen <#ff86c2ff>50 <i#asset/base/ui/banpick/champion_stat_icon:range_0> bereik<> van de vorige, met voorrang voor kampioenen. Dit effect werkt voor <#e8a800ff>150%<> tegen minions en monsters."
