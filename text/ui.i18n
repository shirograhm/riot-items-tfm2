      "author": "shirograhm",
      "why_nerf_component_1": "Każdy przedmiot, w który się ulepsza, radził sobie za dobrze, więc przycinamy element, który je łączy.",
      "why_nerf_component_2": "Cała rodzina jego ulepszeń jest teraz za silna. Zaczynamy od wspólnej części.",
      "why_buff_component_1": "Każdy przedmiot, w który się ulepsza, miał problemy, więc pomagamy im wszystkim naraz.",
      "why_buff_component_2": "Jego ulepszenia zostały w tyle pod każdym względem. Wzmacniamy wspólny element.",
      "why_follow_1": "Dopasowany do ścieżki tworzenia, więc ulepszenie nigdy nie odbierze ci statystyk.",
      "why_follow_2": "Jego statystyki dotrzymują teraz kroku przedmiotom, z których powstaje.",
      "follow_tier": "{Item} (dla wyrównania):",
      "why_nerf_early_1": "Był odrobinę za silny na wczesnym etapie gry.",
      "why_nerf_early_2": "Przewaga, którą daje na początku, rozstrzygała mecze, zanim na dobre się zaczęły.",
      "why_nerf_late_1": "Był odrobinę za silny na późnym etapie gry.",
      "why_nerf_late_2": "Gdy mecz się przeciąga, skaluje się mocniej niż cokolwiek innego.",
      "why_nerf_meta_1": "Zbyt długo był dominującym wyborem w swojej klasie.",
      "why_nerf_meta_2": "Silny zarówno pod względem częstotliwości zakupu, jak i współczynnika zwycięstw. Czas go utemperować.",
      "why_nerf_strong_1": "Wygrywa częściej, niż powinien przedmiot w tej cenie.",
      "why_nerf_strong_2": "Radzi sobie za dobrze niemal u każdego, kto go kupuje.",
      "why_nerf_popular_1": "Stał się domyślnym wyborem i wypiera inne opcje.",
      "why_nerf_popular_2": "Pojawia się teraz w zbyt wielu buildach. Chcemy więcej różnorodności.",
      "why_buff_unbuilt_1": "Stracił wszystkich stałych użytkowników, więc dajemy im powód, by wrócili.",
      "why_buff_unbuilt_2": "Nikt po niego nie sięgał. Dodajemy mu nieco atrakcyjności.",
      "why_buff_unbuilt_3": "Od dawna nie miał okazji zabłysnąć, więc otwieramy mu drzwi.",
      "why_buff_early_1": "Rozkręca się zbyt długo, więc trochę mu pomagamy.",
      "why_buff_early_2": "Po zakupie zbyt słaby, by warto było czekać. Dajemy mu lepszy start.",
      "why_buff_late_1": "Zbyt mocno słabnie w miarę trwania meczu.",
      "why_buff_late_2": "Jego zysk w długich meczach nie dorównuje inwestycji.",
      "why_buff_weak_1": "Od pewnego czasu jest na wyjątkowo niskim poziomie siły.",
      "why_buff_weak_2": "Został w tyle za innymi opcjami w swojej klasie.",
      "why_buff_niche_1": "Obecnie rzadko jest właściwą odpowiedzią, więc poszerzamy jego zastosowania.",
      "why_buff_niche_2": "Zniknął z większości buildów. Mały impuls, by do nich wrócił.",
      "why_adjust_buff_1": "Ten przedmiot był trochę za słaby, więc zwiększamy wartość „{Up}” i lekko zmniejszamy wartość „{Down}”, by utrzymać go w ryzach.",
      "why_adjust_buff_2": "{Item} zostaje w tyle za innymi opcjami, więc inwestujemy w wartość „{Up}”, płacąc za to drobnym cięciem wartości „{Down}”.",
      "why_adjust_buff_3": "Chcemy widzieć {Item} w większej liczbie buildów. Zwiększamy wartość „{Up}”, by był mocniejszym wyborem, i nieco zmniejszamy wartość „{Down}”, by wzmocnienie nie przesadziło.",
      "why_adjust_nerf_1": "Ten przedmiot był dość silny, więc obniżamy wartość „{Down}” i oddajemy mu trochę siły gdzie indziej.",
      "why_adjust_nerf_2": "{Item} radzi sobie za dobrze, więc obniżamy wartość „{Down}”, rekompensując to nieco większą wartością „{Up}”, by nadal był satysfakcjonującym zakupem.",
      "why_adjust_nerf_3": "Przenosimy część siły przedmiotu {Item} z wartości „{Down}” na wartość „{Up}”, co powinno nieco obniżyć jego ogólną skuteczność.",
      "list_and": "{A} i {B}",
      "list_sep": ", ",
      "passive_stat": "{Stat} umiejętności biernej",
      "passive_alone": "umiejętność bierna"
    }
