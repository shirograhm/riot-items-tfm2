      "amount_flat_ad_bracket": "[{A}] ([+{B}% ของ AD])",
      "amount_flat_armor": "[{A}] + [{B}% ของเกราะ]",
      "intro": "ไอเทมได้รับการปรับสมดุลหลังจากแข่งไป {Matches} แมตช์ใน v{Version}",
      "intro_manual": "ไอเทมเหล่านี้ได้รับการปรับด้วยตนเอง",
      "nerfed": "ลดความแรง",
      "buffed": "เพิ่มความแรง",
      "adjusted": "ปรับแต่ง",
      "none": "ไม่มีไอเทมใดถูกเปลี่ยน",
      "author": "shirograhm",
      "why_nerf_component_1": "ไอเทมทุกชิ้นที่อัปเกรดจากไอเทมนี้แรงเกินไป เราจึงลดทอนชิ้นส่วนที่ใช้ร่วมกัน",
      "why_nerf_component_2": "ไอเทมทั้งสายที่อัปเกรดจากชิ้นนี้แรงเกินไปในตอนนี้ เราจะเริ่มจากชิ้นส่วนที่ใช้ร่วมกัน",
      "why_buff_component_1": "ไอเทมทุกชิ้นที่อัปเกรดจากไอเทมนี้ทำผลงานได้ไม่ดี เราจึงช่วยพวกมันทั้งหมดพร้อมกัน",
      "why_buff_component_2": "ไอเทมที่อัปเกรดจากชิ้นนี้ตามหลังในทุกด้าน เราจึงเสริมชิ้นส่วนที่ใช้ร่วมกัน",
      "why_follow_1": "ปรับให้สอดคล้องกับเส้นทางการสร้าง เพื่อให้การอัปเกรดไม่ทำให้คุณเสียค่าสถานะ",
      "why_follow_2": "ค่าสถานะของไอเทมนี้ตามทันไอเทมที่ใช้สร้างแล้ว",
      "follow_tier": "{Item} (ปรับให้ตรงกัน):",
      "why_nerf_early_1": "ไอเทมนี้แรงเกินไปเล็กน้อยในช่วงต้นเกม",
      "why_nerf_early_2": "ความได้เปรียบที่สร้างได้ตั้งแต่ต้นเกมตัดสินผลแมตช์ก่อนที่เกมจะเริ่มจริงจัง",
      "why_nerf_late_1": "ไอเทมนี้แรงเกินไปเล็กน้อยในช่วงท้ายเกม",
      "why_nerf_late_2": "เมื่อเกมยืดเยื้อ ไอเทมนี้ก็แรงขึ้นมากกว่าอะไรทั้งหมด",
      "why_nerf_meta_1": "ไอเทมนี้เป็นตัวเลือกหลักของคลาสมานานเกินไปแล้ว",
      "why_nerf_meta_2": "แรงทั้งในด้านอัตราการซื้อและอัตราชนะ ถึงเวลาปรับให้กลับมาสมดุล",
      "why_nerf_strong_1": "ไอเทมนี้ชนะบ่อยกว่าที่ไอเทมราคานี้ควรจะเป็น",
      "why_nerf_strong_2": "แรงเกินไปสำหรับแทบทุกคนที่ซื้อ",
      "why_nerf_popular_1": "ไอเทมนี้กลายเป็นตัวเลือกมาตรฐานจนเบียดตัวเลือกอื่นออกไป",
      "why_nerf_popular_2": "ตอนนี้ไอเทมนี้อยู่ในบิลด์มากเกินไป เราอยากเห็นความหลากหลายมากกว่านี้",
      "why_buff_unbuilt_1": "ไอเทมนี้เสียผู้ใช้หลักไปทั้งหมด เราจึงให้เหตุผลที่พวกเขาจะกลับมาใช้",
      "why_buff_unbuilt_2": "ไม่มีใครเลือกไอเทมนี้เลย เราจึงเพิ่มความน่าสนใจให้อีกหน่อย",
      "why_buff_unbuilt_3": "ไอเทมนี้ไม่ได้มีโอกาสโดดเด่นมาสักพักแล้ว เราจึงเปิดทางให้",
      "why_buff_early_1": "ไอเทมนี้ใช้เวลานานเกินไปกว่าจะเริ่มได้ผล เราจึงช่วยเร่งให้",
      "why_buff_early_2": "อ่อนเกินไปตอนซื้อจนไม่คุ้มที่จะรอ เราจึงให้จุดเริ่มต้นที่ดีขึ้น",
      "why_buff_late_1": "ไอเทมนี้ตกลงมากเกินไปเมื่อเกมดำเนินไป",
      "why_buff_late_2": "ผลตอบแทนในเกมยาวไม่คุ้มกับที่ลงทุนไป",
      "why_buff_weak_1": "ไอเทมนี้อยู่ในระดับความแรงที่ต่ำเป็นพิเศษมาสักพักแล้ว",
      "why_buff_weak_2": "ไอเทมนี้ตามหลังตัวเลือกอื่นในคลาสเดียวกัน",
      "why_buff_niche_1": "ตอนนี้ไอเทมนี้ไม่ค่อยเป็นคำตอบที่ถูก เราจึงขยายการใช้งานให้กว้างขึ้น",
      "why_buff_niche_2": "ไอเทมนี้หายไปจากบิลด์ส่วนใหญ่ เราจึงดันเล็กน้อยให้กลับมา",
      "why_adjust_buff_1": "ไอเทมนี้อ่อนไปเล็กน้อย เราจึงเพิ่ม {Up} และลด {Down} ลงเล็กน้อยเพื่อไม่ให้แรงเกินไป",
      "why_adjust_buff_2": "{Item} ตามหลังตัวเลือกอื่น เราจึงลงทุนกับ {Up} โดยแลกกับการลด {Down} ลงเล็กน้อย",
      "why_adjust_buff_3": "เราอยากเห็น {Item} ในบิลด์มากขึ้น เราจึงเพิ่ม {Up} ให้เป็นตัวเลือกที่แรงขึ้น และลด {Down} ลงเล็กน้อยเพื่อไม่ให้การเพิ่มความแรงเกินเลย",
      "why_adjust_nerf_1": "ไอเทมนี้ค่อนข้างแรง เราจึงลด {Down} ลงและคืนความแรงให้ในด้านอื่นบ้าง",
      "why_adjust_nerf_2": "{Item} แรงเกินไป เราจึงลด {Down} ลง พร้อมชดเชยด้วย {Up} ที่เพิ่มขึ้นเล็กน้อย เพื่อให้ยังน่าซื้ออยู่",
      "why_adjust_nerf_3": "เราย้ายความแรงบางส่วนของ {Item} จาก {Down} ไปที่ {Up} ซึ่งน่าจะทำให้ประสิทธิภาพโดยรวมลดลงหนึ่งระดับ",
      "list_and": "{A} และ {B}",
      "list_sep": ", ",
      "passive_stat": "{Stat}ของพาสซีฟ",
      "passive_alone": "พาสซีฟ"
    }
  },
