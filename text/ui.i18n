      "none": "No item was changed.",
      "author": "shirograhm",
      "why_nerf_component_1": "Every item it builds into has been over-performing, so we're trimming the piece they share.",
      "why_nerf_component_2": "Its whole family of upgrades is too strong right now. We're starting with the common part.",
      "why_buff_component_1": "Every item it builds into has been struggling, so we're helping them all at once.",
      "why_buff_component_2": "Its upgrades have fallen behind across the board. A boost to the piece they share.",
      "why_follow_1": "Brought in line with its build path, so upgrading never costs you stats.",
      "why_follow_2": "Its stats now keep pace with the items it builds from.",
      "follow_tier": "{Item} (to match):",
      "why_nerf_early_1": "It has been a little too strong in the early game.",
      "why_nerf_early_2": "The leads it builds early have been deciding games before they start.",
      "why_nerf_late_1": "It has been a little too strong in the late game.",
      "why_nerf_late_2": "Once a game goes long, it scales harder than anything else.",
      "why_nerf_meta_1": "It has been the dominant pick for its class for too long.",
      "why_nerf_meta_2": "Powerful in both purchase rate and win rate. Time to bring it back in line.",
      "why_nerf_strong_1": "It has been winning more than an item at its price should.",
      "why_nerf_strong_2": "Over-performing for nearly everyone who builds it.",
      "why_nerf_popular_1": "It has become the default choice, crowding out the other options.",
      "why_nerf_popular_2": "It shows up in too many builds right now. We'd like to see more variety.",
      "why_buff_unbuilt_1": "It has lost all of its core users, so we're giving them a reason to come back.",
      "why_buff_unbuilt_2": "Nobody has been reaching for this one. Adding some appeal.",
      "why_buff_unbuilt_3": "It hasn't had a chance to shine in a while, so we're opening the door.",
      "why_buff_early_1": "It takes too long to get going, so we're helping it along.",
      "why_buff_early_2": "Too weak on purchase to be worth the wait. Giving it a better start.",
      "why_buff_late_1": "It falls off too hard as the game goes on.",
      "why_buff_late_2": "Its payoff in long games hasn't matched the investment.",
      "why_buff_weak_1": "It has been sitting at a particularly low state of power for a while now.",
      "why_buff_weak_2": "It has fallen behind the other options for its class.",
      "why_buff_niche_1": "Rarely the right answer at the moment, so we're widening its uses.",
      "why_buff_niche_2": "It has slipped out of most builds. A small push to get it back in.",
      "why_adjust_buff_1": "This item has been a bit weak, so we're raising its {Up} and trimming its {Down} slightly to keep it in check.",
      "why_adjust_buff_2": "{Item} has been falling behind the other options, so we're investing in its {Up}, paid for with a small cut to its {Down}.",
      "why_adjust_buff_3": "We'd like to see {Item} in more builds. We're giving it more {Up} to make it a stronger pick, and pulling its {Down} back a little so the buff doesn't overshoot.",
      "why_adjust_nerf_1": "This item has been quite strong, so we're toning down its {Down} and giving it back some power elsewhere.",
      "why_adjust_nerf_2": "{Item} has been overperforming, so we're pulling back on its {Down} while compensating with a bit more {Up} to keep it a satisfying buy.",
      "why_adjust_nerf_3": "We're shifting some of {Item}'s power out of its {Down} and into its {Up}, which should bring its overall output down a notch.",
      "list_and": "{A} and {B}",
      "list_sep": ", ",
      "passive_stat": "passive {Stat}",
      "passive_alone": "passive"
    }
