      "author": "shirograhm",
      "why_nerf_component_1": "Elk voorwerp waarnaar het upgradet presteerde te goed, dus snoeien we in het onderdeel dat ze delen.",
      "why_nerf_component_2": "De hele familie upgrades is nu te sterk. We beginnen bij het gedeelde onderdeel.",
      "why_buff_component_1": "Elk voorwerp waarnaar het upgradet had het lastig, dus helpen we ze allemaal tegelijk.",
      "why_buff_component_2": "De upgrades zijn over de hele linie achtergebleven. Een steuntje voor het onderdeel dat ze delen.",
      "why_follow_1": "Gelijkgetrokken met het bouwpad, zodat een upgrade je nooit stats kost.",
      "why_follow_2": "De stats houden nu gelijke tred met de voorwerpen waaruit het wordt gebouwd.",
      "follow_tier": "{Item} (gelijkgetrokken):",
      "why_nerf_early_1": "Het was in de vroege fase net iets te sterk.",
      "why_nerf_early_2": "De vroege voorsprong die het oplevert, besliste wedstrijden al voordat ze begonnen.",
      "why_nerf_late_1": "Het was in de late fase net iets te sterk.",
      "why_nerf_late_2": "Zodra een wedstrijd lang duurt, schaalt het sterker dan al het andere.",
      "why_nerf_meta_1": "Het is al te lang de dominante keuze voor zijn klasse.",
      "why_nerf_meta_2": "Sterk in zowel aankooppercentage als winstpercentage. Tijd om het weer in toom te houden.",
      "why_nerf_strong_1": "Het wint vaker dan een voorwerp van die prijs zou moeten.",
      "why_nerf_strong_2": "Presteert te goed voor bijna iedereen die het bouwt.",
      "why_nerf_popular_1": "Het is de standaardkeuze geworden en verdringt de andere opties.",
      "why_nerf_popular_2": "Het zit nu in te veel builds. We zien graag meer variatie.",
      "why_buff_unbuilt_1": "Het is al zijn vaste gebruikers kwijt, dus geven we ze een reden om terug te komen.",
      "why_buff_unbuilt_2": "Niemand greep nog naar dit voorwerp. We maken het wat aantrekkelijker.",
      "why_buff_unbuilt_3": "Het kreeg al een tijd geen kans om te schitteren, dus zetten we de deur open.",
      "why_buff_early_1": "Het komt te traag op gang, dus helpen we het een handje.",
      "why_buff_early_2": "Bij aankoop te zwak om het wachten waard te zijn. We geven het een betere start.",
      "why_buff_late_1": "Het zakt te hard weg naarmate de wedstrijd vordert.",
      "why_buff_late_2": "Wat het in lange wedstrijden oplevert, weegt niet op tegen de investering.",
      "why_buff_weak_1": "Het zit al een tijd op een bijzonder laag krachtniveau.",
      "why_buff_weak_2": "Het is achtergebleven bij de andere opties voor zijn klasse.",
      "why_buff_niche_1": "Op dit moment zelden het juiste antwoord, dus verbreden we de toepassingen.",
      "why_buff_niche_2": "Het is uit de meeste builds verdwenen. Een klein duwtje om het terug te brengen.",
      "why_adjust_buff_1": "Dit voorwerp was wat zwak, dus verhogen we {Up} en verlagen we {Down} een beetje om het in toom te houden.",
      "why_adjust_buff_2": "{Item} bleef achter bij de andere opties, dus investeren we in {Up}, betaald met een kleine korting op {Down}.",
      "why_adjust_buff_3": "We willen {Item} in meer builds zien. Meer {Up} moet het een sterkere keuze maken, en we halen {Down} iets terug zodat de buff niet doorschiet.",
      "why_adjust_nerf_1": "Dit voorwerp was behoorlijk sterk, dus zwakken we {Down} af en geven we het elders wat kracht terug.",
      "why_adjust_nerf_2": "{Item} presteerde te goed, dus halen we {Down} terug en compenseren we met wat meer {Up}, zodat het een fijne aankoop blijft.",
      "why_adjust_nerf_3": "We verschuiven een deel van de kracht van {Item} van {Down} naar {Up}, wat de totale output een tikje omlaag zou moeten brengen.",
      "list_and": "{A} en {B}",
      "list_sep": ", ",
      "passive_stat": "passieve {Stat}",
      "passive_alone": "passief"
    }
