player_info:empty {
  width: 789px;
  height: 30px;

  #blue_player:empty {
    source: "asset/base/ui/ingame/blue_player";
    width: 332px;
    height: 30px;

    #champion:color {
      x: 302px;

      width: 30px;
      height: 30px;


      color: #263cbfff;

      #icon:image {
        width: 30px;
        height: 30px;

        anchor_x: 0.5;
        anchor_y: 0.5;
        pivot_x: 0.5;
        pivot_y: 0.5;
      }
    }

    #kda:label {
      @"asset/base/style/main#light_label";
      x: 164px;
      y: 1px;

      width: 68px;
      height: 28px;
      size: 18;

      text: "0/0/0";

      align_x: Center;
      align_y: Center;
    }

    #cs:color {
      x: 229px;
      y: 3px;

      width: 62px;
      height: 24px;

      color: #00000000;
      rounding: Uniform {
        rounding: 5;
      }
      ignore_event: true;

      #shine:color {
        width: 100%;
        height: 100%;
        color: #f0a03018;
        rounding: Uniform {
          rounding: 5;
        }
        visible: false;
        ignore_event: true;
      }

      #icon:image {
        x: 4px;
        y: 5px;
        width: 14px;
        height: 14px;
        source: "asset/base/ui/icons/gold";
        color: #f0a030ff;
        visible: false;
        ignore_event: true;
      }

      #value:label {
        @"asset/base/style/main#light_label";
        width: 100%;
        height: 100%;
        size: 18;

        text: "0";

        align_x: Center;
        align_y: Center;
      }
    }

    #items:empty {
      x: 0px;
      y: -1px;
      width: 160px;
      height: 32px;
    }

  }

  #red_player:empty {
    width: 332px;
    height: 30px;

    x: 457px;

    #champion:color {
      width: 30px;
      height: 30px;


      color: #b02e3aff;

      #icon:image {
        width: 30px;
        height: 30px;

        anchor_x: 0.5;
        anchor_y: 0.5;
        pivot_x: 0.5;
        pivot_y: 0.5;
      }
    }

    #kda:label {
      @"asset/base/style/main#light_label";
      x: 96px;
      y: 1px;

      width: 70px;
      height: 28px;
      size: 18;

      text: "0/0/0";

      align_x: Center;
      align_y: Center;
    }

    #cs:color {
      x: 40px;
      y: 3px;

      width: 60px;
      height: 24px;

      color: #00000000;
      rounding: Uniform {
        rounding: 5;
      }
      ignore_event: true;

      #shine:color {
        width: 100%;
        height: 100%;
        color: #f0a03018;
        rounding: Uniform {
          rounding: 5;
        }
        visible: false;
        ignore_event: true;
      }

      #icon:image {
        x: 4px;
        y: 5px;
        width: 14px;
        height: 14px;
        source: "asset/base/ui/icons/gold";
        color: #f0a030ff;
        visible: false;
        ignore_event: true;
      }

      #value:label {
        @"asset/base/style/main#light_label";
        width: 100%;
        height: 100%;
        size: 18;

        text: "0";

        align_x: Center;
        align_y: Center;
      }
    }

    #items:empty {
      x: 172px;
      y: -1px;
      width: 160px;
      height: 32px;
    }

  }

  #diff:empty {
    anchor_y: 0.5;
    pivot_y: 0.5;
    anchor_x: 0.5;
    pivot_x: 0.5;
    width: 85px;
    height: 28px;

    #gold_diff:label {
      @"asset/base/style/main#light_label";
      width: 52px;
      height: 28px;

      anchor_x: 0.5;
      pivot_x: 0.5;
      anchor_y: 0.5;
      pivot_y: 0.5;

      size: 18;

      align_x: Center;
      align_y: Center;

      text: "200";

      #blue_up:image {
        anchor_x: 0;
        pivot_x: 1;

        anchor_y: 0.5;
        pivot_y: 0.5;

        width: 24px;
        height: 24px;

        source: "asset/base/ui/ingame/blue_up";
      }

      #red_up:image {
        anchor_x: 1;
        pivot_x: 0;
        anchor_y: 0.5;
        pivot_y: 0.5;

        width: 24px;
        height: 24px;

        source: "asset/base/ui/ingame/red_up";
      }
    }
  }
}
