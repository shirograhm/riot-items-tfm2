      #back:color_icon_button {
        @"asset/base/style/main#tertiary_button";
        x: 24px;
        y: 1000px;
        width: 400.667px;
        height: 48px;
        icon: { source: "asset/base/ui/icons/undo"; rect: { x: 14; y: 14; w: 20; h: 20; } }
        text: { rect: { x: 42; y: 0; w: 316.667; h: 48; } text: "#asset/base/text/ui?training.comp_test.back"; font: "asset/base/font/set/bold"; size: 18; align_x: Center; align_y: Center; }
      }

      #open_champion_select:color_icon_button {
        @"asset/base/style/main#tertiary_button";
        x: 439.667px;
        y: 1000px;
        width: 400.667px;
        height: 48px;
        text: { rect: { x: 14; y: 0; w: 372.667; h: 48; } text: "#asset/base/text/ui?training.comp_test.open_champion_select"; font: "asset/base/font/set/bold"; size: 18; align_x: Center; align_y: Center; }
      }

      #run:color_icon_button {
        @"asset/base/style/main#tertiary_button";
        x: 855.334px;
        y: 1000px;
        width: 400.667px;
        height: 48px;
        icon: { source: "asset/base/ui/icons/right"; rect: { x: 371; y: 14; w: 20; h: 20; } }
        text: { rect: { x: 42; y: 0; w: 316.667; h: 48; } text: "#asset/base/text/ui?training.comp_test.run"; font: "asset/base/font/set/bold"; size: 18; align_x: Center; align_y: Center; }
      }
    }

    #summary:empty {
      visible: false;
      x: 0px;
      y: 0px;
      width: 1280px;
      height: 900px;

      #title:label {
        @"asset/base/style/main#bold_label";
        x: 24px;
        y: 100px;
        width: 500px;
        height: 34px;
        align_y: Center;
        text: "#asset/base/text/ui?training.comp_test.summary_header";
        size: 20;
      }

      #loading:empty {
        x: 0px;
        y: 0px;
        width: 1280px;
        height: 900px;

        #label:label {
          @"asset/base/style/main#bold_label";
          x: 24px;
          y: 250px;
          width: 1232px;
          height: 42px;
          align_x: Center;
          align_y: Center;
          text: "#asset/base/text/ui?training.comp_test.summary_loading";
          size: 26;
        }

        #loading_bar:color {
          x: 380px;
          y: 324px;
          width: 520px;
          height: 18px;
          color: #4a4c56ff;
          rounding: Uniform { rounding: 9; }

          #fill:color {
            width: 0px;
            height: 18px;
            color: #37d5b3ff;
            rounding: Uniform { rounding: 9; }
          }
        }

        #loading_progress:label {
          @"asset/base/style/main#label";
          x: 380px;
          y: 352px;
          width: 520px;
          height: 30px;
          align_x: Center;
          align_y: Center;
          text: "#asset/base/text/ui?training.comp_test.summary_loading_progress";
          size: 18;
          color: #9a9ca6ff;
        }
      }

      #result:empty {
        visible: false;
        x: 0px;
        y: 0px;
        width: 1280px;
        height: 900px;

        #score:label {
          @"asset/base/style/main#bold_label";
          x: 24px;
          y: 140px;
          width: 1232px;
          height: 44px;
          align_x: Center;
          align_y: Center;
          text: "";
          size: 28;
        }

        #win_tag:label {
          @"asset/base/style/main#bold_label";
          x: 24px;
          y: 110px;
          width: 1232px;
          height: 22px;
          align_x: Center;
          align_y: Center;
          text: "";
          size: 15;
        }

        #objectives:empty {
          x: 255px;
          y: 196px;
          width: 670px;
          height: 36px;
          child_type: LeftToRight {
            spacing: 15px;
          }

          #morgard:empty {
            width: 210px;
            height: 36px;
            #icon:image { x: 0px; y: 7px; width: 22px; height: 22px; source: "asset/base/ui/icons/morgard"; }
            #count:label { @"asset/base/style/main#bold_label"; x: 30px; width: 180px; height: 36px; align_y: Center; text: ""; size: 15; }
          }
          #serpen:empty {
            width: 210px;
            height: 36px;
            #icon:image { x: 0px; y: 7px; width: 22px; height: 22px; source: "asset/base/ui/icons/serpen"; }
            #count:label { @"asset/base/style/main#bold_label"; x: 30px; width: 180px; height: 36px; align_y: Center; text: ""; size: 15; }
          }
          #tower:empty {
            width: 220px;
            height: 36px;
            #icon:image { x: 0px; y: 7px; width: 22px; height: 22px; source: "asset/base/ui/icons/tower"; }
            #count:label { @"asset/base/style/main#bold_label"; x: 30px; width: 190px; height: 36px; align_y: Center; text: ""; size: 15; }
          }
        }

        #tactics:color {
          x: 0px;
          y: 255px;
          width: 1280px;
          height: 172px;
          color: #00000000;
          rounding: Uniform { rounding: 0; }

          #blue_panel:color {
            x: 24px;
            y: 0px;
            width: 320px;
            height: 172px;
            color: #20212bff;
            rounding: Uniform { rounding: 6; }
            #label:label { @"asset/base/style/main#bold_label"; x: 18px; y: 12px; width: 284px; height: 22px; align_y: Center; text: "#asset/base/text/ui?training.comp_test.blue"; size: 14; color: #37d5b3ff; }
            #text:label { @"asset/base/style/main#label"; x: 18px; y: 42px; width: 284px; height: 116px; align_y: Center; text: ""; size: 12; line_height: 16; color: #c2c6ceff; fit_width: true; }
          }

          #red_panel:color {
            x: 936px;
            y: 0px;
            width: 320px;
            height: 172px;
            color: #20212bff;
            rounding: Uniform { rounding: 6; }
            #label:label { @"asset/base/style/main#bold_label"; x: 18px; y: 12px; width: 284px; height: 22px; align_y: Center; text: "#asset/base/text/ui?training.comp_test.red"; size: 14; color: #eb3d4dff; }
            #text:label { @"asset/base/style/main#label"; x: 18px; y: 42px; width: 284px; height: 116px; align_y: Center; text: ""; size: 12; line_height: 16; color: #c2c6ceff; fit_width: true; }
          }
        }

        #bars:empty {
          x: 0px;
          y: 267px;
          width: 1280px;
          height: 148px;

          #deal_label:label { @"asset/base/style/main#label"; x: 0px; y: 0px; width: 1280px; height: 16px; align_x: Center; align_y: Center; text: "#asset/base/text/ui?training.comp_test.bar_deal"; size: 13; color: #9a9ca6ff; }
          #deal_blue:label { @"asset/base/style/main#bold_label"; x: 290px; y: 24px; width: 110px; height: 16px; align_x: Right; align_y: Center; text: "0"; size: 13; color: #37d5b3ff; }
          #deal_red:label { @"asset/base/style/main#bold_label"; x: 880px; y: 24px; width: 110px; height: 16px; align_x: Left; align_y: Center; text: "0"; size: 13; color: #eb3d4dff; }
          #deal_track:color { x: 410px; y: 26px; width: 460px; height: 12px; color: #161721ff; rounding: Uniform { rounding: 6; }
            #blue:color { x: 0px; width: 230px; height: 12px; color: #37d5b3ff; rounding: Individual { top_left: 6; bottom_left: 6; } }
