      #replay:color_icon_button {
        @"asset/base/style/main#tertiary_button";
        x: 24px;
        y: 824px;
        width: 608.5px;
        height: 52px;
        icon: { source: "asset/base/ui/ingame/auto_camera"; rect: { x: 83.25; y: 18.7; w: 20; h: 14.55; } }
        text: { rect: { x: 115.25; y: 0; w: 360; h: 52; } text: "#asset/base/text/ui?training.comp_test.watch_replay"; font: "asset/base/font/set/bold"; size: 18; align_x: Center; align_y: Center; }
      }

      #close:color_icon_button {
        @"asset/base/style/main#tertiary_button";
        x: 647.5px;
        y: 824px;
        width: 608.5px;
        height: 52px;
        text: { rect: { x: 14; y: 0; w: 580.5; h: 52; } text: "#asset/base/text/ui?common.close"; font: "asset/base/font/set/bold"; size: 18; align_x: Center; align_y: Center; }
      }
    }

    #comp_test_tooltips:empty {
      ignore_event: true;
      x: 0px;
      y: 0px;
      width: 1280px;
      height: 900px;
    }
  }

  #comp_test_item_tooltip:color {
    width: 274px;
    height: 250px;
    x: 60px;
    y: 60px;
    visible: false;
    rounding: Uniform { rounding: 12; }
    color: #4a4c56ff;
    image_scale: 0.5;
    left: 12;
    right: 12;
    top: 12;
    bottom: 12;
    ignore_event: true;

    #bg:color {
      anchor_x: 0.5;
      pivot_x: 0.5;
      anchor_y: 0.5;
      pivot_y: 0.5;
      width: 272px;
      height: 248px;
      rounding: Uniform { rounding: 12; }
      color: #161721ff;
      ignore_event: true;
      image_scale: 0.5;
      left: 12;
      right: 12;
      top: 12;
      bottom: 12;
    }

    #data:empty {
      width: 264px;
      height: 237px;
      anchor_x: 0.5;
      pivot_x: 0.5;
      anchor_y: 0.5;
      pivot_y: 0.5;

      #slot:color {
        width: 40px;
        height: 40px;
        rounding: Uniform { rounding: 8; }
        ignore_event: true;
        color: #4a4c56ff;

        #icon:image {
          width: 36px;
          height: 36px;
          anchor_x: 0.5;
          anchor_y: 0.5;
          pivot_x: 0.5;
          pivot_y: 0.5;
          ignore_event: true;
        }
      }

      #name:label {
        @"asset/base/style/main#bold_label";
        width: 200px;
        height: 20px;
        size: 18;
        x: 45px;
        text: "";
      }

      #tier:label {
        @"asset/base/style/main#bold_label";
        width: 119px;
        height: 24px;
        size: 16;
        x: 145px;
        color: #666666ff;
        text: "#asset/base/text/item?tier";
        align_x: Right;
      }

      #gold_icon:image {
        width: 16px;
        height: 16px;
        x: 45px;
        y: 21px;
        ignore_event: true;
        source: "asset/base/ui/gold";
      }

      #price:label {
        @"asset/base/style/main#label";
        width: 92px;
        height: 17px;
        size: 16;
        x: 62px;
        y: 21px;
        text: "1200";
        color: #fde99fff;
        align_y: Center;
      }

      #bar:color {
        width: 264px;
        height: 1px;
        y: 46px;
        ignore_event: true;
        color: #1d1f2cff;
      }

      #desc:label {
        @"asset/base/style/main#label";
        width: 264px;
        height: 185px;
        size: 16;
        line_height: 20;
        anchor_y: 1;
        pivot_y: 1;
        text: "";
      }
    }
  }

}
