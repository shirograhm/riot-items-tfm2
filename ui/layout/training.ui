training:training_ui {
  width: 1600px;
  height: 968px;

  x: 32px;
  y: 24px;

  #tabs:color {
    visible: true;
    y: 0px;
    width: 938px;
    height: 39px;

    padding: {
      left: 4px;
      right: 4px;
      top: 4px;
      bottom: 4px;
    }

    color: #4a4c56ff;
    stroke: 1;
    back_color: #00000000;

    child_type: LeftToRight {
      spacing: 0px;
    }

    rounding: Uniform {
      rounding: 8;
    }

    #team_plan:color_selectable {
      @"asset/base/style/main#strategy_option";
      width: 307px;
      height: 32px;

      label: {
        size: 18;
      }

      selected_label: {
        size: 18;
      }

      text: "#asset/base/text/ui?training.team";
    }

    #personal_plan:color_selectable {
      @"asset/base/style/main#strategy_option";

      width: 323px;
      height: 32px;

      label: {
        size: 18;
      }

      selected_label: {
        size: 18;
      }

      text: "#asset/base/text/ui?training.personal";
    }

    #streaming:color_selectable {
      @"asset/base/style/main#strategy_option";

      width: 300px;
      height: 32px;

      label: {
        size: 18;
      }

      selected_label: {
        size: 18;
      }

      text: "#asset/base/text/ui?training.streaming_tab";
    }
  }

  #delegate_to_coach:color_icon_button {
    @"asset/base/style/main#secondary_button";
    anchor_x: 1;
    pivot_x: 1;
    x: 0px;
    y: 0px;
    width: 180px;
    height: 39px;
    text: {
      font: "asset/base/font/set/bold";
      text: "#asset/base/text/ui?training.delegate_to_head_coach";
      size: 14;
      align_x: Center;
      align_y: Center;
    }
  }

  #unassign_coach:color_icon_button {
    @"asset/base/style/main#secondary_button_active";
    visible: false;
    anchor_x: 1;
    pivot_x: 1;
    x: 0px;
    y: 0px;
    width: 180px;
    height: 39px;
    text: {
      font: "asset/base/font/set/bold";
      text: "#asset/base/text/ui?training.unassign_head_coach";
      size: 14;
      align_x: Center;
      align_y: Center;
    }
  }


  #streaming_period_switcher:empty {
    visible: false;
    y: 0px;
    x: 958px;
    width: 200px;
    height: 39px;

    #left:color_icon_button {
      @"asset/base/style/main#tertiary_button";
      y: 3.5px;
      width: 32px;
      height: 32px;
      icon: {
        source: "asset/base/ui/icons/left";
        rect: {
          x: 13;
          y: 12;
          w: 6;
          h: 8;
        }
      }
    }

    #period_text:label {
      @"asset/base/style/main#bold_label";
