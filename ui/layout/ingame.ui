      height: 248px;

      rounding: Uniform {
        rounding: 12;
      }
      color: #161721ff;
      ignore_event: true;

      image_scale: 0.5;
      left: 12;
      right: 12;
      top: 12;
      bottom: 12;
    }

    #data:empty {
      width: 264px;
      height: 237px;

      anchor_x: 0.5;
      pivot_x: 0.5;
      anchor_y: 0.5;
      pivot_y: 0.5;

      #slot:color {
        width: 40px;
        height: 40px;

        rounding: Uniform {
          rounding: 8;
        }
        ignore_event: true;

        color: #4a4c56ff;

        #icon:image {
          width: 36px;
          height: 36px;

          anchor_x: 0.5;
          anchor_y: 0.5;
          pivot_x: 0.5;
          pivot_y: 0.5;

          ignore_event: true;
        }
      }

      #name:label {
        @"asset/base/style/main#bold_label";
        width: 200px;
        height: 20px;
        size: 18;

        x: 45px;

        text: "";
      }

      #tier:label {
        @"asset/base/style/main#bold_label";
        width: 119px;
        height: 24px;
        size: 16;

        x: 145px;
        color: #666666ff;

        text: "#asset/base/text/item?tier";
        align_x: Right;
      }

      #gold_icon:image {
        width: 16px;
        height: 16px;

        x: 45px;
        y: 21px;
        ignore_event: true;

        source: "asset/base/ui/gold";
      }

      #price:label {
        @"asset/base/style/main#label";
        width: 92px;
        height: 17px;
        size: 16;

        x: 62px;
        y: 21px;

        text: "1200";
        color: #fde99fff;

        align_y: Center;
      }

      #bar:color {
        width: 264px;
        height: 1px;

        y: 46px;
        ignore_event: true;

        color: #1d1f2cff;
      }

      #desc:label {
        @"asset/base/style/main#label";
        width: 264px;
        height: 185px;

        size: 16;
        line_height: 20;

        anchor_y: 1;
        pivot_y: 1;

        text: "";
      }
    }
  }

  #chat_btn_panel:empty {
    width: 36px;
    height: 36px;

    x: 942px;
    y: 988px;

    z: 200;

    visible: false;

    #chat_btn_bg:color {
      width: 36px;
      height: 36px;

      color: #161721ff;

      rounding: Individual {
        top_left: 8;
        top_right: 0;
        bottom_left: 0;
        bottom_right: 0;
      }
    }

    #chat_btn:button {
      width: 20px;
      height: 20px;

      x: 8px;
      y: 8px;

      source: "asset/base/ui/icons/chat";
      color: #a5a5abff;

      hover: {
        color: #e8e8e8ff;
      }

      active: {
        color: #e8e8e8ff;
      }

      #chat_red_dot:color {
        width: 12px;
        height: 12px;

        anchor_x: 1;
        pivot_x: 0.5;
        x: -2px;

        anchor_y: 0;
        pivot_y: 0.5;
        y: 2px;

        ignore_event: true;
        visible: false;

        color: #eb3d4dff;

        rounding: Uniform {
          rounding: 6;
        }
      }
    }
  }

