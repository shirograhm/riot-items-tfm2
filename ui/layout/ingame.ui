ingame:ingame_ui {
  width: 1920px;
  height: 1080px;

  #center_log:empty {
    x: 18px;
    y: 64px;
    width: 960px;
    height: 960px;

    #dm_center:empty {
      width: 100%;
      height: 100%;
      ignore_event: true;

      #count:label {
        @"asset/base/style/main#bold_label";
        anchor_x: 0.5;
        pivot_x: 0.5;
        anchor_y: 0.5;
        pivot_y: 0.5;
        width: 400px;
        height: 220px;
        size: 150;
        outline: 2;
        color: #ffffff99;
        outline_color: #000000cc;
        text: "10";
        align_x: Center;
        align_y: Center;
        visible: false;
      }

      #overtime:empty {
        anchor_x: 0.5;
        pivot_x: 0.5;
        anchor_y: 0.5;
        pivot_y: 0.5;
        width: 960px;
        height: 150px;
        visible: false;

        #title:label {
          @"asset/base/style/main#bold_label";
          anchor_x: 0.5;
          pivot_x: 0.5;
          y: 0px;
          width: 960px;
          height: 76px;
          size: 56;
          outline: 2;
          color: #fad33eff;
          outline_color: #000000ff;
          text: "#asset/base/text/ui?ingame.overtime_title";
          align_x: Center;
          align_y: Center;
        }

        #desc:label {
          @"asset/base/style/main#bold_label";
          anchor_x: 0.5;
          pivot_x: 0.5;
          y: 82px;
          width: 960px;
          height: 48px;
          size: 28;
          outline: 1;
          color: #e8e8e8ff;
          outline_color: #000000ff;
          text: "#asset/base/text/ui?ingame.overtime_desc";
          align_x: Center;
          align_y: Center;
        }
      }
    }
  }

  #header:color {
    color: #161721ff;

    width: 1920px;
    height: 50px;

    #blue_bar:color {
      color: #5b73ffff;

      width: 4px;
      height: 50px;
    }

    #blue_info:empty {
      width: 633px;
      height: 50px;

      #logo:image {
        x: 20px;
        anchor_y: 0.5;
        pivot_y: 0.5;
        height: 40px;
        width: 40px;

        sample_linear: false;
        source: "asset/base/aseprite_resources/team_logo";
        rect_tag: "0_0";
      }

      #team_name:label {
        @"asset/base/style/main#bold_label";
        size: 26;
        text: "Rapid Storm";
        anchor_y: 0.5;
        pivot_y: 0.5;

        x: 65px;
        width: 300px;
        height: 50px;
        align_y: Center;

        #sets:empty {
          x: 10px;
          anchor_x: 1;
          pivot_x: 0;
          
          anchor_y: 0.5;
          pivot_y: 0.5;
          height: 20px;

          child_type: LeftToRight {
            spacing: 5px;
          }
        }
      }
    }

    #red_info:empty {
      width: 633px;
      height: 50px;
      x: -20px;
      anchor_x: 1;
      pivot_x: 1;

      #logo:image {
        anchor_x: 1;
        pivot_x: 1;
        x: -20px;
        anchor_y: 0.5;
        pivot_y: 0.5;
        height: 40px;
        width: 40px;

        sample_linear: false;
        source: "asset/base/aseprite_resources/team_logo";
        rect_tag: "1_0";
      }

      #team_name:label {
        @"asset/base/style/main#bold_label";
        size: 26;
        text: "Kinetic Surge";
        
        pivot_x: 1;
        anchor_x: 1;

        align_x: Right;
        align_y: Center;

        x: -65px;
        width: 300px;
        height: 50px;

        #sets:empty {
          x: -10px;
          anchor_x: 0;
          pivot_x: 1;
          
          anchor_y: 0.5;
          pivot_y: 0.5;
          height: 20px;

          child_type: LeftToRight {
            spacing: 5px;
          }
        }
      }
    }

    #blue_morgard_buff:color {
      x: 380px;
      y: 9px;
      width: 210px;
      height: 32px;
      visible: false;
      ignore_event: true;
      back_color: #1f2230ff;
      color: #4a4c56ff;
      rounding: Uniform {
        rounding: 8;
      }

      #fx:canvas {
        width: 100%;
        height: 100%;
        ignore_event: true;
      }

      #icon:image {
        x: 8px;
        y: 6px;
        width: 20px;
        height: 20px;
        source: "asset/base/ui/icons/morgard";
        color: #5b73ffff;
      }

      #text:label {
        @"asset/base/style/main#bold_label";
        x: 34px;
        y: 1px;
        width: 168px;
        height: 30px;
        size: 16;
        align_y: Center;
        fit_width: true;
      }
    }

