  #chat_panel:color {
    width: 44px;
    height: 44px;

    anchor_x: 1;
    pivot_x: 1;
    anchor_y: 1;
    pivot_y: 1;

    x: -27px;
    y: -26px;

    visible: false;

    color: #1d1f2cff;

    rounding: Uniform {
      rounding: 8;
    }

    #chat_btn:button {
      width: 24px;
      height: 24px;

      anchor_x: 0.5;
      pivot_x: 0.5;
      anchor_y: 0.5;
      pivot_y: 0.5;

      source: "asset/base/ui/icons/chat";
      color: #a5a5abff;

      hover: {
        color: #e8e8e8ff;
      }

      active: {
        color: #e8e8e8ff;
      }

      #chat_red_dot:color {
        width: 14px;
        height: 14px;

        anchor_x: 1;
        pivot_x: 0.5;
        x: -3px;

        anchor_y: 0;
        pivot_y: 0.5;
        y: 3px;

        ignore_event: true;
        visible: false;

        color: #eb3d4dff;

        rounding: Uniform {
          rounding: 7;
        }
      }
    }
  }

  #next:color_icon_button {
    @"asset/base/style/main#primary_button";
    width: 379px;
    height: 80px;

    anchor_x: 0.5;
    anchor_y: 1;

