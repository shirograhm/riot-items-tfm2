  #damage_popup:color {
    width: 268px;
    height: 106px;
    z: 1000;
    x: 60px;
    y: 60px;
    visible: false;
    ignore_event: true;

    rounding: Uniform { rounding: 12; }
    color: #4a4c56ff;

    #bg:color {
      anchor_x: 0.5;
      pivot_x: 0.5;
      anchor_y: 0.5;
      pivot_y: 0.5;
      width: 266px;
      height: 104px;
      z: 1001;
      ignore_event: true;
      rounding: Uniform { rounding: 12; }
      color: #161721ff;
    }

    #rows:empty {
      x: 14px;
      y: 11px;
      width: 240px;
      height: 84px;
      z: 1001;

      #ad:empty {
        width: 240px;
        height: 28px;
        z: 1002;

        #dot:color {
          anchor_y: 0.5;
          pivot_y: 0.5;
          width: 12px;
          height: 12px;
          z: 1003;
          ignore_event: true;
          color: #ff9028ff;
          rounding: Uniform { rounding: 3; }
        }

        #name:label {
          @"asset/base/style/main#label";
          x: 18px;
          width: 118px;
          height: 28px;
          z: 1003;
          size: 18;
          color: #a5a5abff;
          align_y: Center;
          text: "#asset/base/text/ui?set_result.damage_ad";
        }

        #value:label {
          @"asset/base/style/main#label";
          anchor_x: 1;
          pivot_x: 1;
          width: 118px;
          height: 28px;
          z: 1003;
          size: 18;
          align_x: Right;
          align_y: Center;
          text: "0";
        }
      }

      #ap:empty {
        y: 28px;
        width: 240px;
        height: 28px;
        z: 1002;

        #dot:color {
          anchor_y: 0.5;
          pivot_y: 0.5;
          width: 12px;
          height: 12px;
          z: 1003;
          ignore_event: true;
          color: #a974ffff;
          rounding: Uniform { rounding: 3; }
        }

        #name:label {
          @"asset/base/style/main#label";
          x: 18px;
          width: 118px;
          height: 28px;
          z: 1003;
          size: 18;
          color: #a5a5abff;
          align_y: Center;
          text: "#asset/base/text/ui?set_result.damage_ap";
        }

        #value:label {
          @"asset/base/style/main#label";
          anchor_x: 1;
          pivot_x: 1;
          width: 118px;
          height: 28px;
          z: 1003;
          size: 18;
          align_x: Right;
          align_y: Center;
          text: "0";
        }
      }

      #fixed:empty {
        y: 56px;
        width: 240px;
        height: 28px;
        z: 1002;

        #dot:color {
          anchor_y: 0.5;
          pivot_y: 0.5;
          width: 12px;
          height: 12px;
          z: 1003;
          ignore_event: true;
          color: #f5f5f5ff;
          rounding: Uniform { rounding: 3; }
        }

        #name:label {
          @"asset/base/style/main#label";
          x: 18px;
          width: 118px;
          height: 28px;
          z: 1003;
          size: 18;
          color: #a5a5abff;
          align_y: Center;
          text: "#asset/base/text/ui?set_result.damage_fixed";
        }

        #value:label {
          @"asset/base/style/main#label";
          anchor_x: 1;
          pivot_x: 1;
          width: 118px;
          height: 28px;
          z: 1003;
          size: 18;
          align_x: Right;
          align_y: Center;
          text: "0";
        }
      }
    }
  }

  #item_tooltip:color {
    width: 274px;
    height: 250px;
    z: 1010;
    x: 60px;
    y: 60px;
    visible: false;
    rounding: Uniform { rounding: 12; }
    color: #4a4c56ff;
    image_scale: 0.5;
    left: 12;
    right: 12;
    top: 12;
    bottom: 12;
    ignore_event: true;

    #bg:color {
      anchor_x: 0.5;
      pivot_x: 0.5;
      anchor_y: 0.5;
      pivot_y: 0.5;
      width: 272px;
      height: 248px;
      z: 1011;
      rounding: Uniform { rounding: 12; }
      color: #161721ff;
      ignore_event: true;
      image_scale: 0.5;
      left: 12;
      right: 12;
      top: 12;
      bottom: 12;
    }

    #data:empty {
      width: 264px;
      height: 237px;
      z: 1011;
      anchor_x: 0.5;
      pivot_x: 0.5;
      anchor_y: 0.5;
      pivot_y: 0.5;

      #slot:color {
        width: 40px;
        height: 40px;
        z: 1012;
        rounding: Uniform { rounding: 8; }
        ignore_event: true;
        color: #4a4c56ff;

        #icon:image {
          width: 36px;
          height: 36px;
          z: 1013;
          anchor_x: 0.5;
          anchor_y: 0.5;
          pivot_x: 0.5;
          pivot_y: 0.5;
          ignore_event: true;
        }
      }

      #name:label {
        @"asset/base/style/main#bold_label";
        width: 200px;
        height: 20px;
        z: 1012;
        size: 18;
        x: 45px;
        text: "";
      }

      #tier:label {
        @"asset/base/style/main#bold_label";
        width: 119px;
        height: 24px;
        z: 1012;
        size: 16;
        x: 145px;
        color: #666666ff;
        text: "#asset/base/text/item?tier";
        align_x: Right;
      }

      #gold_icon:image {
        width: 16px;
        height: 16px;
        z: 1012;
        x: 45px;
        y: 21px;
        ignore_event: true;
        source: "asset/base/ui/gold";
      }

      #price:label {
        @"asset/base/style/main#label";
        width: 92px;
        height: 17px;
        z: 1012;
        size: 16;
        x: 62px;
        y: 21px;
        text: "1200";
        color: #fde99fff;
        align_y: Center;
      }

      #bar:color {
        width: 264px;
        height: 1px;
        z: 1012;
        y: 46px;
        ignore_event: true;
        color: #1d1f2cff;
      }

      #desc:label {
        @"asset/base/style/main#label";
        width: 264px;
        height: 185px;
        z: 1012;
        size: 16;
        line_height: 20;
        anchor_y: 1;
        pivot_y: 1;
        text: "";
      }
    }
  }

}
