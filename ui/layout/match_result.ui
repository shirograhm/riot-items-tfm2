          height: 28px;
          anchor_x: 0.5;
          pivot_x: 0.5;

          #left_btn:color_icon_button {
            @"asset/base/style/main#tertiary_button";
            width: 40px;
            height: 40px;
            anchor_x: 0.2;
            pivot_x: 0.5;
            anchor_y: 0.5;
            pivot_y: 0.5;
            icon: {
              source: "asset/base/ui/icons/left";
              rect: {
                x: 17.47;
                y: 15.61;
                w: 5.06;
                h: 8.78;
              }
            }
          }

          #title:label {
            @"asset/base/style/main#bold_label";
