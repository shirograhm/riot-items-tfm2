          height: 24px;

          #ad:empty {
            width: 200px;
            height: 24px;

            #dot:color {
              anchor_y: 0.5;
              pivot_y: 0.5;
              width: 12px;
              height: 12px;
              ignore_event: true;
              color: #ff9028ff;
              rounding: Uniform {
