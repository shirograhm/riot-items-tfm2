              height: 24px;
              size: 18;
              color: #a5a5abff;
              align_y: Center;
              text: "#asset/base/text/ui?set_result.damage_fixed";
            }
          }
        }

        #container:empty {
          y: 88px;
          width: 856px;
          height: 605px;

          child_type: LeftToRight {
            spacing: 0px;
          }

          #blue_side:empty {
            width: 428px;
            height: 605px;

            child_type: TopToBottom {
              spacing: 23px;
            }

            padding: {
              top: 6px;
              right: 20px;
              left: 14px;
              bottom: 6px;
            }
          }

          #red_side:empty {
            width: 428px;
            height: 605px;

            child_type: TopToBottom {
              spacing: 23px;
            }

            padding: {
              top: 6px;
              right: 14px;
              left: 20px;
              bottom: 6px;
            }
          }
        }
