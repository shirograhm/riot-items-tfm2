main:match_result_ui {
  width: 100%;
  height: 100%;

  #background:color {
    width: 100%;
    height: 100%;

    color: #07080bff;
  }

  #header:color {
    source: "asset/base/sprite/white";
    width: 100%;
    height: 85px;
    color: #161721ff;

    #text:label {
      @"asset/base/style/main#label";
      height: 100%;
      width: 100%;

      align_x: Center;
      align_y: Center;
      color: #e8e8e8ff;
      size: 30;
      text: "#asset/base/text/ui?set_result.header";
    }
  }

  #contents:color {
    source: "asset/base/sprite/white";
    width: 1864px;
    height: 828px;
    y: 122px;

    anchor_x: 0.5;
    pivot_x: 0.5;

    color: #161721ff;
    rounding: Uniform {
      rounding: 12;
    }

    child_type: TopToBottom {
      spacing: 0px;
    }

    #header:empty {
      width: 1826px;
      height: 100px;

      anchor_x: 0.5;
      pivot_x: 0.5;

      #blue_side_mark:color {
        anchor_y: 0.5;
        pivot_y: 0.5;
        x: 0px;
        width: 4px;
        height: 56px;

        ignore_event: true;
        color: #5b73ffff;
        rounding: Uniform {
          rounding: 2;
        }
      }

      #blue_logo:image {
        anchor_y: 0.5;
        pivot_y: 0.5;
        x: 14px;
        height: 56px;
        width: 56px;

        sample_linear: false;
        source: "asset/base/aseprite_resources/team_logo";
        rect_tag: "0_0";
      }

      #blue_team:label {
        @"asset/base/style/main#bold_label";
        size: 36;
        text: "Rapid Storm Super Rapid";

        anchor_y: 0.5;
        pivot_y: 0.5;
        align_y: Center;

        x: 84px;
        width: 400px;
        height: 40px;
      }

      #blue_set:label {
        @"asset/base/style/main#bold_label";
        size: 30;

        anchor_y: 0.5;
        pivot_y: 0.5;
        align_x: Center;
        align_y: Center;

        x: 500px;
        width: 50px;
        height: 40px;
        text: "1";
      }

      #blue_state:label {
        @"asset/base/style/main#bold_label";
        size: 30;

        anchor_y: 0.5;
        pivot_y: 0.5;
        align_x: Center;
        align_y: Center;

        x: 600px;
        width: 200px;
        height: 40px;
        text: "#asset/base/text/ui?set_result.lose";
      }

      #red_side_mark:color {
        anchor_x: 1;
        pivot_x: 1;
        anchor_y: 0.5;
        pivot_y: 0.5;
        x: 0px;
        width: 4px;
        height: 56px;

        ignore_event: true;
        color: #ef6471ff;
        rounding: Uniform {
          rounding: 2;
        }
      }

      #red_logo:image {
        anchor_x: 1;
        pivot_x: 1;
        anchor_y: 0.5;
        pivot_y: 0.5;
        x: -14px;
        height: 56px;
        width: 56px;

        sample_linear: false;
        source: "asset/base/aseprite_resources/team_logo";
        rect_tag: "0_0";
      }

      #red_team:label {
        anchor_x: 1;
        pivot_x: 1;
        @"asset/base/style/main#bold_label";
        size: 36;
        text: "Rapid Storm Super Rapid";

        anchor_y: 0.5;
        pivot_y: 0.5;
        align_y: Center;
        align_x: Right;

        x: -84px;
        width: 400px;
        height: 40px;
      }

      #red_set:label {
        @"asset/base/style/main#bold_label";
        size: 30;

        anchor_x: 1;
        pivot_x: 1;
        anchor_y: 0.5;
        pivot_y: 0.5;
        align_x: Center;
        align_y: Center;

        x: -500px;
        width: 50px;
        height: 40px;
        text: "0";
      }

      #red_state:label {
        @"asset/base/style/main#bold_label";
        size: 30;

        anchor_y: 0.5;
        pivot_y: 0.5;
        align_x: Center;
        align_y: Center;
        anchor_x: 1;
        pivot_x: 1;

        x: -600px;
        width: 200px;
        height: 40px;
        text: "#asset/base/text/ui?set_result.lose";
      }

      #game_time:empty {
        anchor_x: 0.5;
        pivot_x: 0.5;
        anchor_y: 0.5;
        pivot_y: 0.5;

        width: 200px;
        height: 56px;

        child_type: TopToBottom {
          spacing: 0px;
        }

        #header:label {
          @"asset/base/style/main#label";
          size: 18;

          width: 100%;
          height: 24px;

          align_x: Center;
          align_y: Center;

          text: "#asset/base/text/ui?set_result.time";
        }

        #value:label {
          @"asset/base/style/main#bold_label";
          size: 30;
          
          width: 100%;
          height: 32px;

          align_x: Center;
          align_y: Center;

          text: "12:34";
        }
      }
    }

    #bar:color {
      color: #4a4c56ff;

      width: 1826px;
      height: 1px;

      anchor_x: 0.5;
      pivot_x: 0.5;
    }

    #data:empty {
      y: 12px;

      anchor_x: 0.5;
      pivot_x: 0.5;

      width: 1826px;
      height: 693px;

      #damage:empty {
        width: 856px;
        height: 693px;

        #header:empty {
          y: 10px;
