statistics:statistics_ui {
  width: 1600px;
  height: 968px;

  x: 32px;
  y: 24px;

  #tabs:color {
    x: 0px;
    width: 936px;
    height: 39px;

    padding: {
      left: 4px;
      right: 4px;
      top: 4px;
      bottom: 4px;
    }

    color: #4a4c56ff;
    stroke: 1;
    back_color: #00000000;

    child_type: LeftToRight {
      spacing: 0px;
    }

    rounding: Uniform {
      rounding: 8;
    }

    #champion:color_selectable {
      @"asset/base/style/main#strategy_option";
      width: 232px;
      height: 32px;

      label: {
        size: 18;
      }

      selected_label: {
        size: 18;
      }

      text: "#asset/base/text/ui?statistics.champion";
    }

    #athlete:color_selectable {
      @"asset/base/style/main#strategy_option";

      width: 232px;
      height: 32px;

      label: {
        size: 18;
      }

      selected_label: {
        size: 18;
      }

      text: "#asset/base/text/ui?statistics.athlete";
    }

    #team:color_selectable {
      @"asset/base/style/main#strategy_option";

      width: 232px;
      height: 32px;

      label: {
        size: 18;
      }

      selected_label: {
        size: 18;
      }

      text: "#asset/base/text/ui?statistics.team";
    }

    #item:color_selectable {
      @"asset/base/style/main#strategy_option";

      width: 232px;
      height: 32px;

      label: {
        size: 18;
      }

      selected_label: {
        size: 18;
      }

      text: "#asset/base/text/ui?item_stats.tab";
    }
  }

  #position:dropdown {
    @"asset/base/style/main#dropdown";
    anchor_x: 1;
    pivot_x: 1;
    x: -194px;
    width: 216px;
    height: 40px;

    text: {
      size: 18;
    }

    item_text: {
      size: 18;
    }

    text_layout: {
      x: 36px;
      y: 6px;
      width: 100%;
      height: 28px;
    }

    selected_item_icon_layout: {
      x: 12px;
      y: 11px;
      width: 18px;
      height: 18px;
    }

    item_icon_layout: {
      y: 11px;
      width: 18px;
      height: 18px;
    }

    item_layout: {
      height: 40px;
      width: 211.5px;
      x: 12px;
    }

    item_text_layout: {
      x: 25px;
      y: 6px;
      width: 211.5px;
      height: 28px;
    }
  }

  #patch:dropdown {
    @"asset/base/style/main#dropdown";
    anchor_x: 1;
    pivot_x: 1;
    width: 186px;
    height: 40px;
    max_items_height: 400;

    text: {
      size: 18;
    }

    item_text: {
      size: 18;
    }

    text_layout: {
      x: 14px;
      y: 6px;
      width: 100%;
      height: 28px;
    }

    item_layout: {
      height: 40px;
      width: 181.5px;
      x: 14px;
    }

    item_text_layout: {
      y: 6px;
      width: 181.5px;
      height: 28px;
    }
  }

  #year_filter:dropdown {
    @"asset/base/style/main#dropdown";
    anchor_x: 1;
    pivot_x: 1;
    width: 186px;
    height: 40px;
    max_items_height: 400;

    visible: false;

    text: {
      size: 18;
    }

    item_text: {
      size: 18;
    }

    text_layout: {
      x: 14px;
      y: 6px;
      width: 100%;
      height: 28px;
    }

    item_layout: {
      height: 40px;
      width: 181.5px;
      x: 14px;
    }

    item_text_layout: {
      y: 6px;
      width: 181.5px;
      height: 28px;
    }
  }

  #league_filter:dropdown {
    @"asset/base/style/main#dropdown";
    anchor_x: 1;
    pivot_x: 1;
    x: -194px;
    width: 216px;
    height: 40px;
    max_items_height: 400;

    visible: false;

    text: {
      size: 18;
    }

    item_text: {
      size: 18;
    }

    text_layout: {
      x: 14px;
      y: 6px;
      width: 100%;
      height: 28px;
    }

    item_layout: {
      height: 40px;
      width: 211.5px;
      x: 14px;
    }

    item_text_layout: {
      y: 6px;
      width: 211.5px;
      height: 28px;
    }
  }

  #data:color {
    y: 52px;
    width: 1600px;
    height: 916px;

    color: #161721ff;

    rounding: Uniform {
      rounding: 12;
    }

    #athlete:empty {
      width: 1600px;
      height: 916px;

      visible: false;

      #header:color {
        width: 1600px;
        height: 56px;
        color: #0f1016ff;
        rounding: Individual {
          top_left: 12;
          top_right: 12;
        }

