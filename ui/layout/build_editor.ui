build_editor:empty {
  width: 1920px;
  height: 1080px;
  z: 300;
  visible: false;

  #fade:color_icon_button {
    width: 100%;
    height: 100%;

    btn: {
      color: #60708540;
    }
  }

  #popup:color {
    width: 1360px;
    height: 600px;

    anchor_x: 0.5;
    pivot_x: 0.5;
    anchor_y: 0.5;
    pivot_y: 0.5;

    color: #161721ff;

    rounding: Uniform {
      rounding: 12;
    }

    #titlebar:color {
      width: 1360px;
      height: 50px;

      color: #0f1016ff;

      rounding: Individual {
        top_left: 12;
        top_right: 12;
      }

      #title:label {
        @"asset/base/style/main#bold_label";
        x: 24px;
        anchor_y: 0.5;
        pivot_y: 0.5;
        width: 600px;
        height: 28px;
        size: 18;
        align_y: Center;
        color: #e8e8e8ff;
        text: "Item Build Editor";
      }

      #cancel:button {
        width: 16px;
        height: 16px;

        anchor_x: 1;
        pivot_x: 1;
        x: -24px;
        anchor_y: 0.5;
        pivot_y: 0.5;

        source: "asset/base/ui/icons/cross";

        color: #c2c6ceff;

        hover: {
          color: #e8e8e8ff;
        }

        active: {
          color: #e8e8e8ff;
        }
      }
    }

    #toolbar:color {
      y: 50px;
      width: 1360px;
      height: 60px;

      color: #0f1016ff;

      #save:color_icon_button {
        @"asset/base/style/main#primary_button";
        x: 15px;
        y: 11px;
        width: 180px;
        height: 38px;

        text: {
          font: "asset/base/font/set/bold";
          text: "Save Item Builds";
          align_x: Center;
          align_y: Center;
          size: 15;
        }
      }

      #status:label {
        @"asset/base/style/main#label";
        x: 210px;
        y: 11px;
        width: 1130px;
        height: 38px;
        align_y: Center;
        size: 14;
        color: #a5a5abff;
        text: "";
      }
    }

    #optionbar:color {
      y: 110px;
      width: 1360px;
      height: 46px;

      color: #0f1016ff;

      #unique:color_icon_button {
        @"asset/base/style/main#tertiary_button";
        x: 15px;
        y: 6px;
        width: 260px;
        height: 34px;

        text: {
          text: "Enforcing unique items";
          align_x: Center;
          align_y: Center;
          size: 14;
        }
      }

      #hint:label {
        @"asset/base/style/main#label";
        anchor_x: 1;
        pivot_x: 1;
        x: -15px;
        y: 6px;
        width: 900px;
        height: 34px;
        align_x: Right;
        align_y: Center;
        size: 13;
        color: #a5a5abff;
        text: "Click a slot to pick an item. Click the pinned item again, or the X, to hand the slot back to the AI.";
      }
    }

    #colheader:empty {
      x: 15px;
      y: 156px;
      width: 1330px;
      height: 32px;

      #c_position:label {
        @"asset/base/style/main#label";
        x: 8px;
        width: 290px;
        height: 32px;
        align_y: Center;
        size: 13;
        color: #a5a5abff;
        text: "POSITION";
      }

      #c_item1:label {
        @"asset/base/style/main#label";
        x: 306px;
        width: 300px;
        height: 32px;
        align_x: Center;
        align_y: Center;
        size: 13;
        color: #a5a5abff;
        text: "ITEM 1";
      }

      #c_item2:label {
        @"asset/base/style/main#label";
        x: 652px;
        width: 300px;
        height: 32px;
        align_x: Center;
        align_y: Center;
        size: 13;
        color: #a5a5abff;
        text: "ITEM 2";
      }

      #c_item3:label {
        @"asset/base/style/main#label";
        x: 998px;
        width: 300px;
        height: 32px;
        align_x: Center;
        align_y: Center;
        size: 13;
        color: #a5a5abff;
        text: "ITEM 3";
      }
    }

    #rows:empty {
      x: 15px;
      y: 188px;
      width: 1330px;
      height: 320px;

      child_type: TopToBottom {
        spacing: 8px;
      }
    }

    #footer:color {
      anchor_y: 1;
      pivot_y: 1;
      width: 1360px;
      height: 26px;

      color: #0f1016ff;

      rounding: Individual {
        bottom_left: 12;
        bottom_right: 12;
      }

      #version:label {
        @"asset/base/style/main#label";
        anchor_x: 1;
        pivot_x: 1;
        x: -14px;
        width: 500px;
        height: 26px;
        align_x: Right;
        align_y: Center;
        size: 12;
        color: #a5a5abff;
        text: "";
      }
    }
  }

  #itemlist:empty {
    visible: false;

    width: 320px;
    height: 430px;
    z: 400;

    #panel:color {
      width: 320px;
      height: 430px;

      color: #0f1016ff;

      rounding: Uniform {
        rounding: 6;
      }
    }

    #list:scroll_view {
      x: 3px;
      y: 3px;
      width: 314px;
      height: 424px;

      speed: 100;

      bar_width: 4;
      bar: {
        source: "asset/base/sprite/white";
        color: #60ddc2ff;

        hover: {
          color: #ecfbf8ff;
        }
      }

      back: {
        source: "asset/base/sprite/white";
        color: #4a4c56ff;
      }

      #contents:empty {
        width: 304px;
        height: auto;

        child_type: TopToBottom {
          spacing: 0px;
        }
      }
    }
  }
}
