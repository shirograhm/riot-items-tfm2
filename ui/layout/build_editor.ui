build_editor:empty {
  width: 1920px;
  height: 1080px;
  z: 300;
  visible: false;

  #popup:color {
    x: 47px;
    y: 182px;
    width: 1364px;
    height: 645px;

    color: #1d1f2cff;

    rounding: Uniform {
      rounding: 12;
    }

    #toolbar:color {
      width: 1364px;
      height: 60px;

      color: #0f1016ff;

      rounding: Individual {
        top_left: 12;
        top_right: 12;
      }

      #add:color_icon_button {
        @"asset/base/style/main#tertiary_button";
        x: 15px;
        y: 11px;
        width: 180px;
        height: 38px;

        text: {
          font: "asset/base/font/set/bold";
          text: "+ Add Champion";
          align_x: Center;
          align_y: Center;
          size: 15;
        }
      }

      #search:text_edit {
        @"asset/base/style/main#text_edit";
        x: 205px;
        y: 10px;
        width: 260px;
        height: 40px;
        size: 14;
        align_y: Center;
        padding: {
          left: 44px;
          top: 5px;
          right: 15px;
          bottom: 5px;
        }
        placeholder: "filter by champion...";
        max_length: 40;

        #icon:image {
          ignore_event: true;
          x: -30px;
          y: 5px;
          width: 20px;
          height: 20px;
          source: "asset/base/ui/banpick/fi-rr-search";
          color: #858d9dff;
        }
      }

      #searchclear:color_icon_button {
        visible: false;

        x: 475px;
        y: 19px;
        width: 22px;
        height: 22px;

        btn: { color: #00000000; }

        icon: {
          source: "asset/base/ui/icons/cross";
          rect: { x: 6px; y: 6px; w: 10px; h: 10px; }
        }

        #glyph:image {
          ignore_event: true;
          x: 6px;
          y: 6px;
          width: 10px;
          height: 10px;
          source: "asset/base/ui/icons/cross";
          color: #60ddc2ff;
        }
      }

      #hint:label {
        @"asset/base/style/main#label";
        anchor_x: 1;
        pivot_x: 1;
        x: -15px;
        y: 13px;
        width: 640px;
        height: 34px;
        align_x: Right;
        align_y: Center;
        size: 13;
        color: #a5a5abff;
        text: "Builds are per champion. A blank slot is filled by the game, in the AI's own pick order.";
      }
    }

    #colheader:empty {
      x: 15px;
      y: 60px;
      width: 1334px;
      height: 32px;

      #c_champion:label {
        @"asset/base/style/main#label";
        x: 8px;
        width: 280px;
        height: 32px;
        align_x: Left;
        align_y: Center;
        size: 13;
        color: #a5a5abff;
        text: "CHAMPION";
      }

      #c_role:label {
        @"asset/base/style/main#label";
        x: 296px;
        width: 128px;
        height: 32px;
        align_x: Left;
        align_y: Center;
        size: 13;
        color: #a5a5abff;
        text: "ROLE";
      }

      #c_item1:label {
        @"asset/base/style/main#label";
        x: 306px;
        width: 280px;
        height: 32px;
        align_x: Left;
        align_y: Center;
        size: 13;
        color: #a5a5abff;
        text: "ITEM 1";
      }

      #c_item2:label {
        @"asset/base/style/main#label";
        x: 630px;
        width: 280px;
        height: 32px;
        align_x: Left;
        align_y: Center;
        size: 13;
        color: #a5a5abff;
        text: "ITEM 2";
      }

      #c_item3:label {
        @"asset/base/style/main#label";
        x: 954px;
        width: 280px;
        height: 32px;
        align_x: Left;
        align_y: Center;
        size: 13;
        color: #a5a5abff;
        text: "ITEM 3";
      }
    }

    #rowscroll:scroll_view {
      x: 15px;
      y: 92px;
      width: 1334px;
      height: 486px;

      speed: 100;

      bar_width: 4;
      bar: {
        source: "asset/base/sprite/white";
        color: #60ddc2ff;

        hover: {
          color: #ecfbf8ff;
        }
      }

      back: {
        source: "asset/base/sprite/white";
        color: #4a4c56ff;
      }

      #rows:empty {
        width: 1314px;
        height: auto;

        child_type: TopToBottom {
          spacing: 10px;
        }
      }
    }

    #footer:color {
      anchor_y: 1;
      pivot_y: 1;
      width: 1364px;
      height: 60px;

      color: #0f1016ff;

      rounding: Individual {
        bottom_left: 12;
        bottom_right: 12;
      }

      #unique:color {
        x: 15px;
        y: 10px;
        width: 358px;
        height: 40px;

        padding: {
          left: 4px;
          right: 4px;
          top: 4px;
          bottom: 4px;
        }

        color: #4a4c56ff;
        stroke: 1;
        back_color: #00000000;

        child_type: LeftToRight {
          spacing: 0px;
        }

        rounding: Uniform {
          rounding: 8;
        }

        #on:color_selectable {
          @"asset/base/style/main#strategy_option";
          width: 175px;
          height: 32px;

          label: {
            size: 13;
            align_x: Center;
          }

          selected_label: {
            size: 13;
            align_x: Center;
          }

          text: "Unique Items Enforced";
        }

        #off:color_selectable {
          @"asset/base/style/main#strategy_option";
          width: 175px;
          height: 32px;

          label: {
            size: 13;
            align_x: Center;
          }

          selected_label: {
            size: 13;
            align_x: Center;
          }

          text: "Duplicates Allowed";
        }
      }

      #scope:color {
        x: 385px;
        y: 10px;
        width: 358px;
        height: 40px;

        padding: {
          left: 4px;
          right: 4px;
          top: 4px;
          bottom: 4px;
        }

        color: #4a4c56ff;
        stroke: 1;
        back_color: #00000000;

        child_type: LeftToRight {
          spacing: 0px;
        }

        rounding: Uniform {
          rounding: 8;
        }

        #all:color_selectable {
          @"asset/base/style/main#strategy_option";
          width: 175px;
          height: 32px;

          label: {
            size: 13;
            align_x: Center;
          }

          selected_label: {
            size: 13;
            align_x: Center;
          }

          text: "Apply To All Players";
        }

        #own:color_selectable {
          @"asset/base/style/main#strategy_option";
          width: 175px;
          height: 32px;

          label: {
            size: 13;
            align_x: Center;
          }

          selected_label: {
            size: 13;
            align_x: Center;
          }

          text: "Apply To Your Players Only";
        }
      }

      #saved:image {
        visible: false;
        ignore_event: true;

        anchor_x: 1;
        pivot_x: 1;
        x: -205px;
        y: 19px;
        width: 22px;
        height: 22px;

        source: "asset/base/ui/icons/check";
        color: #60ddc2ff;
      }

      #save:color_icon_button {
        @"asset/base/style/main#primary_button";
        anchor_x: 1;
        pivot_x: 1;
        x: -15px;
        y: 11px;
        width: 180px;
        height: 38px;

        text: {
          font: "asset/base/font/set/bold";
          text: "Save Item Builds";
          align_x: Center;
          align_y: Center;
          size: 15;
        }
      }
    }
  }

  #listcatch:color_icon_button {
    visible: false;

    width: 100%;
    height: 100%;

    btn: {
      color: #00000000;
    }
  }

  #itemlist:empty {
    visible: false;

    width: 320px;
    height: 430px;
    z: 400;

    #panel:color {
      width: 320px;
      height: 430px;

      color: #0f1016ff;

      rounding: Uniform {
        rounding: 6;
      }
    }

    #list:scroll_view {
      x: 3px;
      y: 3px;
      width: 314px;
      height: 424px;

      speed: 100;

      bar_width: 4;
      bar: {
        source: "asset/base/sprite/white";
        color: #60ddc2ff;

        hover: {
          color: #ecfbf8ff;
        }
      }

      back: {
        source: "asset/base/sprite/white";
        color: #4a4c56ff;
      }

      #contents:empty {
        width: 304px;
        height: auto;

        child_type: TopToBottom {
          spacing: 0px;
        }
      }
    }
  }

  #rolelist:empty {
    visible: false;

    width: 160px;
    height: 186px;
    z: 400;

    #panel:color {
      width: 160px;
      height: 186px;

      color: #0f1016ff;

      rounding: Uniform {
        rounding: 6;
      }
    }

    #list:scroll_view {
      x: 3px;
      y: 3px;
      width: 154px;
      height: 180px;

      speed: 100;

      bar_width: 4;
      bar: {
        source: "asset/base/sprite/white";
        color: #60ddc2ff;

        hover: {
          color: #ecfbf8ff;
        }
      }

      back: {
        source: "asset/base/sprite/white";
        color: #4a4c56ff;
      }

      #contents:empty {
        width: 144px;
        height: auto;

        child_type: TopToBottom {
          spacing: 0px;
        }
      }
    }
  }

  #champlist:empty {
    visible: false;

    width: 260px;
    height: 430px;
    z: 400;

    #panel:color {
      width: 260px;
      height: 430px;

      color: #0f1016ff;

      rounding: Uniform {
        rounding: 6;
      }
    }

    #list:scroll_view {
      x: 3px;
      y: 3px;
      width: 254px;
      height: 424px;

      speed: 100;

      bar_width: 4;
      bar: {
        source: "asset/base/sprite/white";
        color: #60ddc2ff;

        hover: {
          color: #ecfbf8ff;
        }
      }

      back: {
        source: "asset/base/sprite/white";
        color: #4a4c56ff;
      }

      #contents:empty {
        width: 244px;
        height: auto;

        child_type: TopToBottom {
          spacing: 0px;
        }
      }
    }
  }
}
