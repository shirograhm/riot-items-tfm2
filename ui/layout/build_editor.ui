build_editor:empty {
  width: 1920px;
  height: 1080px;
  z: 300;
  visible: false;

  #popup:color {
    x: 47px;
    y: 182px;
    width: 1364px;
    height: 645px;

    color: #1d1f2cff;

    rounding: Uniform {
      rounding: 12;
    }

    #toolbar:color {
      width: 1364px;
      height: 60px;

      color: #0f1016ff;

      rounding: Individual {
        top_left: 12;
        top_right: 12;
      }

      #add:color_icon_button {
        @"asset/base/style/main#tertiary_button";
        x: 15px;
        y: 11px;
        width: 180px;
        height: 38px;

        text: {
          font: "asset/base/font/set/bold";
          text: "+ Add Champion";
          align_x: Center;
          align_y: Center;
          size: 15;
        }
      }

      #status:label {
        @"asset/base/style/main#label";
        x: 210px;
        y: 11px;
        width: 1130px;
        height: 38px;
        align_y: Center;
        size: 14;
        color: #a5a5abff;
        text: "";
      }
    }

    #optionbar:color {
      y: 60px;
      width: 1364px;
      height: 46px;

      color: #0f1016ff;

      #unique:color_icon_button {
        @"asset/base/style/main#tertiary_button";
        x: 15px;
        y: 6px;
        width: 260px;
        height: 34px;

        text: {
          text: "Enforcing unique items";
          align_x: Center;
          align_y: Center;
          size: 14;
        }
      }

      #hint:label {
        @"asset/base/style/main#label";
        anchor_x: 1;
        pivot_x: 1;
        x: -15px;
        y: 6px;
        width: 900px;
        height: 34px;
        align_x: Right;
        align_y: Center;
        size: 13;
        color: #a5a5abff;
        text: "Builds are per champion. A blank slot is filled by the game, in the order the AI would have picked.";
      }
    }

    #colheader:empty {
      x: 15px;
      y: 106px;
      width: 1334px;
      height: 32px;

      #c_champion:label {
        @"asset/base/style/main#label";
        x: 8px;
        width: 280px;
        height: 32px;
        align_y: Center;
        size: 13;
        color: #a5a5abff;
        text: "CHAMPION";
      }

      #c_item1:label {
        @"asset/base/style/main#label";
        x: 306px;
        width: 280px;
        height: 32px;
        align_x: Center;
        align_y: Center;
        size: 13;
        color: #a5a5abff;
        text: "ITEM 1";
      }

      #c_item2:label {
        @"asset/base/style/main#label";
        x: 630px;
        width: 280px;
        height: 32px;
        align_x: Center;
        align_y: Center;
        size: 13;
        color: #a5a5abff;
        text: "ITEM 2";
      }

      #c_item3:label {
        @"asset/base/style/main#label";
        x: 954px;
        width: 280px;
        height: 32px;
        align_x: Center;
        align_y: Center;
        size: 13;
        color: #a5a5abff;
        text: "ITEM 3";
      }
    }

    #rowscroll:scroll_view {
      x: 15px;
      y: 138px;
      width: 1334px;
      height: 440px;

      speed: 100;

      bar_width: 4;
      bar: {
        source: "asset/base/sprite/white";
        color: #60ddc2ff;

        hover: {
          color: #ecfbf8ff;
        }
      }

      back: {
        source: "asset/base/sprite/white";
        color: #4a4c56ff;
      }

      #rows:empty {
        width: 1314px;
        height: auto;

        child_type: TopToBottom {
          spacing: 10px;
        }
      }
    }

    #footer:color {
      anchor_y: 1;
      pivot_y: 1;
      width: 1364px;
      height: 60px;

      color: #0f1016ff;

      rounding: Individual {
        bottom_left: 12;
        bottom_right: 12;
      }

      #save:color_icon_button {
        @"asset/base/style/main#primary_button";
        anchor_x: 1;
        pivot_x: 1;
        x: -15px;
        y: 11px;
        width: 180px;
        height: 38px;

        text: {
          font: "asset/base/font/set/bold";
          text: "Save Item Builds";
          align_x: Center;
          align_y: Center;
          size: 15;
        }
      }
    }
  }

  #listcatch:color_icon_button {
    visible: false;

    width: 100%;
    height: 100%;

    btn: {
      color: #00000000;
    }
  }

  #itemlist:empty {
    visible: false;

    width: 320px;
    height: 430px;
    z: 400;

    #panel:color {
      width: 320px;
      height: 430px;

      color: #0f1016ff;

      rounding: Uniform {
        rounding: 6;
      }
    }

    #list:scroll_view {
      x: 3px;
      y: 3px;
      width: 314px;
      height: 424px;

      speed: 100;

      bar_width: 4;
      bar: {
        source: "asset/base/sprite/white";
        color: #60ddc2ff;

        hover: {
          color: #ecfbf8ff;
        }
      }

      back: {
        source: "asset/base/sprite/white";
        color: #4a4c56ff;
      }

      #contents:empty {
        width: 304px;
        height: auto;

        child_type: TopToBottom {
          spacing: 0px;
        }
      }
    }
  }

  #champlist:empty {
    visible: false;

    width: 260px;
    height: 430px;
    z: 400;

    #panel:color {
      width: 260px;
      height: 430px;

      color: #0f1016ff;

      rounding: Uniform {
        rounding: 6;
      }
    }

    #list:scroll_view {
      x: 3px;
      y: 3px;
      width: 254px;
      height: 424px;

      speed: 100;

      bar_width: 4;
      bar: {
        source: "asset/base/sprite/white";
        color: #60ddc2ff;

        hover: {
          color: #ecfbf8ff;
        }
      }

      back: {
        source: "asset/base/sprite/white";
        color: #4a4c56ff;
      }

      #contents:empty {
        width: 244px;
        height: auto;

        child_type: TopToBottom {
          spacing: 0px;
        }
      }
    }
  }
}
